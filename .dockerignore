# Version Control
.git
.gitignore

# Dependencies (Let Docker install these inside the container)
node_modules/
jspm_packages/
web_components/
venv/
.venv/
env/
__pycache__/
*.pyc

# Local Environment & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs and Text Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Build, Test, and Log Output
dist/
build/
out/
.next/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files (Optional, avoids passing the config into the daemon)
Dockerfile
.dockerignore
